{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "nodeVersion": "24.18.0",
  "redirects": [{ "source": "/", "destination": "/zh-CN", "statusCode": 302 }],
  "headers": [
    {
      "source": "/r0-compat",
      "headers": [{ "key": "X-Portal-Routing", "value": "edgeone-native-v1" }]
    },
    {
      "source": "/r0-compat/*",
      "headers": [{ "key": "X-Portal-Routing", "value": "edgeone-native-v1" }]
    }
  ],
  "cloudFunctions": {
    "maxDuration": 30,
    "regions": {
      "overseas": ["na-ashburn"]
    }
  }
}
